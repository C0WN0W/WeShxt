# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# LSPosed 按 assets/xposed_init 里的类名反射实例化入口，必须保留
-keep class com.cownow.weshit.Entry { *; }
-keep class com.cownow.weshit.AntiRevoke { *; }
-keep class com.cownow.weshit.DexScanner { *; }

# DexKit 内部通过反射还原 Method/Class，类名不能被裁剪或重命名
-keep class org.luckypray.dexkit.** { *; }
-keep class com.google.flatbuffers.** { *; }

# Xposed API 只在编译期存在，运行时由 LSPosed 注入
-dontwarn de.robv.android.xposed.**
-dontwarn org.luckypray.dexkit.**
